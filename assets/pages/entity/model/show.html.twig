{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- block page_body -%}
    <div class="block block--padded block--vertical">
        <h2>{{ model.name }}</h2>

        {{ properties(
            [
                { key: '@page::field.maker' | trans, value: model.maker },
                { key: '@page::field.api_id' | trans, value: model.apiId },
            ],
            { bordered: true }
        ) }}
    </div>
{%- endblock -%}
