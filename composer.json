{
  "name": "wexample/symfony-ai",
  "description": "What an application offers to an agent: the tools it runs for it on the server, the pages it opens to it, the shapes of their exchanges",
  "version": "6.0.2",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAi\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "psr/cache": "^3.0",
    "symfony/cache": ">=7.4 || ^8.0",
    "symfony/lock": ">=7.4 || ^8.0",
    "symfony/security-bundle": ">=7.4 || ^8.0",
    "wexample/symfony-design-system": ">=43.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=27.3.0"
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  }
}